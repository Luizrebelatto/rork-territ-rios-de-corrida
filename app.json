{
  "expo": {
    "name": "Territórios de Corrida",
    "slug": "territorios-de-corrida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.territorios-de-corrida",
      "config": {
        "googleMapsApiKey": "test"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Este app precisa da sua localização para rastrear suas corridas e conquistar territórios.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Este app precisa da sua localização para rastrear suas corridas em segundo plano."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "test"
        }
      },
      "package": "app.rork.territorios_de_corrida",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
